{% extends 'base.html.twig' %}
{% block title %}Tableau de bord — EZScore_v1{% endblock %}
{% block body %}
<header class="page-head"><div><div class="eyebrow">EZScore_v1</div><h1>Tableau de bord</h1></div><span class="role-badge">{{ app.user.primaryRole|replace({'ROLE_':''}) }}</span></header>
<div class="dashboard-grid">
    <a class="module-card" href="{{ path('app_catalog') }}"><strong>Répertoire</strong><span>Morceaux et workspace UI mock.</span></a>
    <a class="module-card" href="{{ path('app_playlists') }}"><strong>Playlists</strong><span>Personnelles et de groupe.</span></a>
    <a class="module-card" href="{{ path('app_groups') }}"><strong>Groupes</strong><span>Membres et rôles de groupe.</span></a>
    {% if is_granted('ROLE_ADMIN') %}<a class="module-card" href="{{ path('admin_users') }}"><strong>Utilisateurs</strong><span>Admin, éditeur, lecteur.</span></a>{% endif %}
</div>
{% endblock %}
