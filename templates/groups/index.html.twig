{% extends 'base.html.twig' %}
{% block title %}{{ 'groups.title'|trans }} — EZScore_v1{% endblock %}
{% block body %}
<header class="page-head">
    <div>
        <div class="eyebrow">{{ 'groups.eyebrow'|trans }}</div>
        <h1>{{ 'groups.title'|trans }}</h1>
    </div>
</header>

{% if is_granted('ROLE_ADMIN') %}
<section class="panel">
    <h2>{{ 'groups.create.heading'|trans }}</h2>
    <form method="post" class="inline-form">
        <input type="hidden" name="_token" value="{{ csrf_token('create_group') }}">
        <input name="name" placeholder="{{ 'groups.name'|trans }}" required>
        <input name="description" placeholder="{{ 'groups.description'|trans }}">
        <button class="primary">{{ 'common.create'|trans }}</button>
    </form>
</section>
{% endif %}

<div class="card-grid">
{% for group in groups %}
<section class="panel group-card">
    <h2>{{ group.name }}</h2>
    <p>{{ group.description ?: '—' }}</p>

    <div class="member-list">
        {% for member in members_by_group[group.id]|default([]) %}
            <div>
                <strong>{{ member.user.displayName }}</strong>
                <span>{{ ('group_role.' ~ member.role)|trans }}</span>
            </div>
        {% else %}
            <em>{{ 'groups.no_members'|trans }}</em>
        {% endfor %}
    </div>

    {% if is_granted('ROLE_ADMIN') %}
    <form method="post" action="{{ path('app_group_member_add', {id: group.id}) }}" class="inline-form compact">
        <input type="hidden" name="_token" value="{{ csrf_token('group_' ~ group.id) }}">
        <input type="email" name="email" placeholder="{{ 'groups.member.email'|trans }}" required>
        <select name="role">
            <option value="member">{{ 'group_role.member'|trans }}</option>
            <option value="manager">{{ 'group_role.manager'|trans }}</option>
            <option value="owner">{{ 'group_role.owner'|trans }}</option>
        </select>
        <button>{{ 'groups.member.save'|trans }}</button>
    </form>
    {% endif %}
</section>
{% else %}
    <div class="empty">{{ 'groups.empty'|trans }}</div>
{% endfor %}
</div>
{% endblock %}
