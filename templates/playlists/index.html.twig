{% extends 'base.html.twig' %}
{% block title %}{{ 'playlists.title'|trans }} — EZScore_v1{% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" href="/assets/css/playlists.css?v=20260925r18">
    <link rel="stylesheet" href="/assets/css/entity-picker.css?v=20260925r18">
{% endblock %}
{% block body %}
<header class="page-head">
    <div>
        <div class="eyebrow">{{ 'playlists.eyebrow'|trans }}</div>
        <h1>{{ 'playlists.title'|trans }}</h1>
        <p class="page-note">{{ 'playlists_r18.note'|trans({}, 'picker') }}</p>
    </div>
</header>

{% if pending_invitations %}
<section class="panel playlist-invitations">
    <h2>{{ 'playlists.invitation.received_heading'|trans({}, 'management') }}</h2>
    {% for invitation in pending_invitations %}
        <div class="playlist-invitation-row">
            <span>
                <strong>{{ invitation.playlist.name }}</strong>
                <small>{{ 'playlists.invitation.from'|trans({'%name%': invitation.invitedBy ? invitation.invitedBy.displayName : '—'}, 'management') }}</small>
            </span>
            <span class="playlist-invitation-actions">
                <form method="post" action="{{ path('app_playlist_invitation_respond', {'_locale': app.request.locale, id: invitation.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('playlist_invitation_respond_' ~ invitation.id) }}">
                    <input type="hidden" name="action" value="accept">
                    <button class="primary" type="submit">{{ 'playlists.invitation.accept'|trans({}, 'management') }}</button>
                </form>
                <form method="post" action="{{ path('app_playlist_invitation_respond', {'_locale': app.request.locale, id: invitation.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('playlist_invitation_respond_' ~ invitation.id) }}">
                    <input type="hidden" name="action" value="decline">
                    <button type="submit">{{ 'playlists.invitation.decline'|trans({}, 'management') }}</button>
                </form>
            </span>
        </div>
    {% endfor %}
</section>
{% endif %}

<section class="panel">
    <h2>{{ 'playlists.create.heading'|trans }}</h2>
    <form method="post" class="playlist-form" data-dirty-track>
        <input type="hidden" name="_token" value="{{ csrf_token('create_playlist') }}">
        <input name="name" placeholder="{{ 'playlists.name'|trans }}" required>
        <input name="description" placeholder="{{ 'playlists.description'|trans }}">
        {% if can_publish_playlist %}
            <label class="check">
                <input type="checkbox" name="public" value="1">
                {{ 'playlists.public'|trans }}
            </label>
        {% endif %}
        <button class="primary" type="submit">{{ 'common.create'|trans }}</button>
    </form>
</section>

<div class="card-grid">
{% for playlist in playlists %}
<section class="panel playlist-card">
    {% set can_edit = is_granted('PLAYLIST_EDIT', playlist) %}

    {% if can_edit %}
        <form method="post" action="{{ path('app_playlist_update', {'_locale': app.request.locale, id: playlist.id}) }}" class="playlist-form" data-dirty-track>
            <input type="hidden" name="_token" value="{{ csrf_token('playlist_update_' ~ playlist.id) }}">
            <input name="name" value="{{ playlist.name }}" required>
            <input name="description" value="{{ playlist.description }}">
            {% if can_publish_playlist %}
                <label class="check">
                    <input type="checkbox" name="public" value="1" {{ playlist.public ? 'checked' : '' }}>
                    {{ 'playlists.public'|trans }}
                </label>
            {% endif %}
            <button class="primary" type="submit">{{ 'common.save'|trans }}</button>
        </form>

        <form method="post" action="{{ path('app_playlist_delete', {'_locale': app.request.locale, id: playlist.id}) }}" class="inline-form compact" onsubmit="return confirm('{{ 'playlists.delete.confirm'|trans({'%name%': playlist.name}, 'management')|e('js') }}');">
            <input type="hidden" name="_token" value="{{ csrf_token('playlist_delete_' ~ playlist.id) }}">
            <button type="submit">{{ 'common.delete'|trans({}, 'management') }}</button>
        </form>
    {% else %}
        <h2>{{ playlist.name }}</h2>
        <p>{{ playlist.description ?: '—' }}</p>
    {% endif %}

    <div class="playlist-meta-line">
        <span class="collection-chip">{{ 'playlists_r18.owner'|trans({}, 'picker') }}: {{ playlist.ownerUser.displayName }}</span>
        {% for group in groups_by_playlist[playlist.id]|default([]) %}
            <span class="collection-chip">{{ group.name }}</span>
        {% endfor %}
    </div>

    {% if is_granted('PLAYLIST_INVITE', playlist) %}
    <div class="playlist-share-block">
        <h3>{{ 'playlists.invitation.heading'|trans({}, 'management') }}</h3>

        <div class="collection-actions">
            <button type="button"
                    data-entity-picker
                    data-picker-title="{{ 'playlists_r18.invite_users'|trans({}, 'picker') }}"
                    data-picker-url="{{ path('app_picker_users', {'_locale': app.request.locale, playlist_id: playlist.id, membership: 'out'}) }}"
                    data-picker-submit-url="{{ path('app_playlist_invitations_bulk_add', {'_locale': app.request.locale, id: playlist.id}) }}"
                    data-picker-csrf="{{ csrf_token('playlist_invitations_bulk_' ~ playlist.id) }}">
                {{ 'playlists_r18.invite_users'|trans({}, 'picker') }}
            </button>
            <button type="button"
                    data-entity-picker
                    data-picker-title="{{ 'playlists_r18.remove_shares'|trans({}, 'picker') }}"
                    data-picker-url="{{ path('app_picker_users', {'_locale': app.request.locale, playlist_id: playlist.id, membership: 'in'}) }}"
                    data-picker-submit-url="{{ path('app_playlist_invitations_bulk_remove', {'_locale': app.request.locale, id: playlist.id}) }}"
                    data-picker-csrf="{{ csrf_token('playlist_invitations_bulk_' ~ playlist.id) }}">
                {{ 'playlists_r18.remove_shares'|trans({}, 'picker') }}
            </button>
        </div>

        {% for invitation in invitations_by_playlist[playlist.id]|default([]) %}
            <span class="collection-chip">
                {{ invitation.invitedUser.displayName }} · {{ ('playlists.invitation.status.' ~ invitation.status.value)|trans({}, 'management') }}
            </span>
        {% endfor %}
    </div>
    {% elseif accepted_invitations_by_playlist[playlist.id]|default(null) %}
        {% set accepted_invitation = accepted_invitations_by_playlist[playlist.id] %}
        <form method="post" action="{{ path('app_playlist_invitation_respond', {'_locale': app.request.locale, id: accepted_invitation.id}) }}" class="inline-form compact">
            <input type="hidden" name="_token" value="{{ csrf_token('playlist_invitation_respond_' ~ accepted_invitation.id) }}">
            <input type="hidden" name="action" value="leave">
            <button type="submit">{{ 'playlists.invitation.leave'|trans({}, 'management') }}</button>
        </form>
    {% endif %}

    <div class="playlist-song-block">
        <h3>{{ 'playlists.song.heading'|trans({}, 'management') }}</h3>

        {% set playlist_items = items_by_playlist[playlist.id]|default([]) %}
        {% if playlist_items %}
            <ol class="playlist-song-list">
            {% for item in playlist_items %}
                <li>
                    <span class="playlist-song-title">
                        <strong>{{ item.song.title }}</strong>
                        <small>{{ item.song.artist }}</small>
                    </span>
                    {% if can_edit and is_granted('PLAYLIST_REORDER', playlist) %}
                        <span class="playlist-song-actions">
                            <form method="post" action="{{ path('app_playlist_song_move', {'_locale': app.request.locale, playlistId: playlist.id, itemId: item.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('playlist_song_move_' ~ item.id) }}">
                                <input type="hidden" name="direction" value="up">
                                <button type="submit">↑</button>
                            </form>
                            <form method="post" action="{{ path('app_playlist_song_move', {'_locale': app.request.locale, playlistId: playlist.id, itemId: item.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('playlist_song_move_' ~ item.id) }}">
                                <input type="hidden" name="direction" value="down">
                                <button type="submit">↓</button>
                            </form>
                        </span>
                    {% endif %}
                </li>
            {% endfor %}
            </ol>
        {% else %}
            <p class="playlist-song-empty">{{ 'playlists.song.empty'|trans({}, 'management') }}</p>
        {% endif %}

        {% if can_edit %}
            <div class="collection-actions">
                <button type="button"
                        data-entity-picker
                        data-picker-title="{{ 'playlists_r18.add_songs'|trans({}, 'picker') }}"
                        data-picker-url="{{ path('app_picker_songs', {'_locale': app.request.locale, playlist_id: playlist.id, membership: 'out'}) }}"
                        data-picker-submit-url="{{ path('app_playlist_songs_bulk_add', {'_locale': app.request.locale, id: playlist.id}) }}"
                        data-picker-csrf="{{ csrf_token('playlist_songs_bulk_' ~ playlist.id) }}">
                    {{ 'playlists_r18.add_songs'|trans({}, 'picker') }}
                </button>
                <button type="button"
                        data-entity-picker
                        data-picker-title="{{ 'playlists_r18.remove_songs'|trans({}, 'picker') }}"
                        data-picker-url="{{ path('app_picker_songs', {'_locale': app.request.locale, playlist_id: playlist.id, membership: 'in'}) }}"
                        data-picker-submit-url="{{ path('app_playlist_songs_bulk_remove', {'_locale': app.request.locale, id: playlist.id}) }}"
                        data-picker-csrf="{{ csrf_token('playlist_songs_bulk_' ~ playlist.id) }}">
                    {{ 'playlists_r18.remove_songs'|trans({}, 'picker') }}
                </button>
            </div>
        {% endif %}
    </div>
</section>
{% else %}
    <div class="empty">{{ 'playlists.empty'|trans }}</div>
{% endfor %}
</div>

{% include 'components/_entity_picker_modal.html.twig' %}
{% endblock %}
{% block javascripts %}
    <script src="/assets/js/entity-picker.js?v=20260925r18"></script>
{% endblock %}
