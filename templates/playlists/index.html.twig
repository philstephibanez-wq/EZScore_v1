{% extends 'base.html.twig' %}
{% block title %}{{ 'playlists.title'|trans }} — EZScore_v1{% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" href="/assets/css/playlists.css?v=20260925r14">
{% endblock %}
{% block body %}
<header class="page-head">
    <div>
        <div class="eyebrow">{{ 'playlists.eyebrow'|trans }}</div>
        <h1>{{ 'playlists.title'|trans }}</h1>
    </div>
</header>

<section class="panel">
    <h2>{{ 'playlists.create.heading'|trans }}</h2>
    <form method="post" class="playlist-form" data-dirty-track>
        <input type="hidden" name="_token" value="{{ csrf_token('create_playlist') }}">
        <input name="name" placeholder="{{ 'playlists.name'|trans }}" required>
        <input name="description" placeholder="{{ 'playlists.description'|trans }}">

        <select name="owner_type" class="owner-type">
            <option value="user">{{ 'playlists.owner.personal'|trans }}</option>
            {% if groups %}<option value="group">{{ 'playlists.owner.group'|trans }}</option>{% endif %}
        </select>

        <select name="group_id" class="group-owner" hidden>
            {% for group in groups %}<option value="{{ group.id }}">{{ group.name }}</option>{% endfor %}
        </select>

        <label class="check">
            <input type="checkbox" name="public" value="1">
            {{ 'playlists.public'|trans }}
        </label>

        <button class="primary" type="submit">{{ 'common.create'|trans }}</button>
    </form>
</section>

<div class="card-grid">
{% for playlist in playlists %}
<section class="panel playlist-card">
    {% if editable_playlists[playlist.id]|default(false) %}
        <form method="post" action="{{ path('app_playlist_update', {'_locale': app.request.locale, id: playlist.id}) }}" class="playlist-form" data-dirty-track>
            <input type="hidden" name="_token" value="{{ csrf_token('playlist_update_' ~ playlist.id) }}">
            <input name="name" value="{{ playlist.name }}" placeholder="{{ 'playlists.name'|trans }}" required>
            <input name="description" value="{{ playlist.description }}" placeholder="{{ 'playlists.description'|trans }}">

            <select name="owner_type" class="owner-type">
                <option value="user" {{ playlist.ownerType == 'user' ? 'selected' : '' }}>{{ 'playlists.owner.personal'|trans }}</option>
                {% if groups %}<option value="group" {{ playlist.ownerType == 'group' ? 'selected' : '' }}>{{ 'playlists.owner.group'|trans }}</option>{% endif %}
            </select>

            <select name="group_id" class="group-owner" {{ playlist.ownerType != 'group' ? 'hidden' : '' }}>
                {% for group in groups %}
                    <option value="{{ group.id }}" {{ playlist.ownerType == 'group' and playlist.ownerId == group.id ? 'selected' : '' }}>{{ group.name }}</option>
                {% endfor %}
            </select>

            <label class="check">
                <input type="checkbox" name="public" value="1" {{ playlist.public ? 'checked' : '' }}>
                {{ 'playlists.public'|trans }}
            </label>

            <button class="primary" type="submit">{{ 'common.save'|trans }}</button>
        </form>

        <form method="post" action="{{ path('app_playlist_delete', {'_locale': app.request.locale, id: playlist.id}) }}" class="inline-form compact" onsubmit="return confirm('{{ 'playlists.delete.confirm'|trans({'%name%': playlist.name}, 'management')|e('js') }}');">
            <input type="hidden" name="_token" value="{{ csrf_token('playlist_delete_' ~ playlist.id) }}">
            <button type="submit">{{ 'common.delete'|trans({}, 'management') }}</button>
        </form>
    {% else %}
        <div class="eyebrow">{{ playlist.ownerType == 'group' ? ('playlists.owner.group'|trans) : ('playlists.owner.personal'|trans) }}</div>
        <h2>{{ playlist.name }}</h2>
        <p>{{ playlist.description ?: '—' }}</p>
        <small>{{ playlist.public ? ('playlists.visibility.public'|trans) : ('playlists.visibility.private'|trans) }}</small>
    {% endif %}

    <div class="playlist-song-block">
        <h3>{{ 'playlists.song.heading'|trans({}, 'management') }}</h3>

        {% set playlist_items = items_by_playlist[playlist.id]|default([]) %}
        {% if playlist_items %}
            <ol class="playlist-song-list">
                {% for item in playlist_items %}
                    <li>
                        <span class="playlist-song-title">
                            <strong>{{ item.song.title }}</strong>
                            <small>{{ item.song.artist }}</small>
                        </span>

                        {% if editable_playlists[playlist.id]|default(false) %}
                            <span class="playlist-song-actions">
                                <form method="post" action="{{ path('app_playlist_song_move', {'_locale': app.request.locale, playlistId: playlist.id, itemId: item.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('playlist_song_move_' ~ item.id) }}">
                                    <input type="hidden" name="direction" value="up">
                                    <button type="submit" title="{{ 'playlists.song.move_up'|trans({}, 'management') }}" aria-label="{{ 'playlists.song.move_up'|trans({}, 'management') }}">↑</button>
                                </form>
                                <form method="post" action="{{ path('app_playlist_song_move', {'_locale': app.request.locale, playlistId: playlist.id, itemId: item.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('playlist_song_move_' ~ item.id) }}">
                                    <input type="hidden" name="direction" value="down">
                                    <button type="submit" title="{{ 'playlists.song.move_down'|trans({}, 'management') }}" aria-label="{{ 'playlists.song.move_down'|trans({}, 'management') }}">↓</button>
                                </form>
                                <form method="post" action="{{ path('app_playlist_song_delete', {'_locale': app.request.locale, playlistId: playlist.id, itemId: item.id}) }}" onsubmit="return confirm('{{ 'playlists.song.remove_confirm'|trans({'%title%': item.song.title}, 'management')|e('js') }}');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('playlist_song_delete_' ~ item.id) }}">
                                    <button type="submit">{{ 'common.remove'|trans({}, 'management') }}</button>
                                </form>
                            </span>
                        {% endif %}
                    </li>
                {% endfor %}
            </ol>
        {% else %}
            <p class="playlist-song-empty">{{ 'playlists.song.empty'|trans({}, 'management') }}</p>
        {% endif %}

        {% if editable_playlists[playlist.id]|default(false) and available_songs %}
            <form method="post" action="{{ path('app_playlist_song_add', {'_locale': app.request.locale, id: playlist.id}) }}" class="playlist-song-add">
                <input type="hidden" name="_token" value="{{ csrf_token('playlist_song_add_' ~ playlist.id) }}">
                <select name="song_id" required>
                    <option value="">{{ 'playlists.song.choose'|trans({}, 'management') }}</option>
                    {% for song in available_songs %}
                        <option value="{{ song.id }}">{{ song.artist }} — {{ song.title }}</option>
                    {% endfor %}
                </select>
                <button type="submit">{{ 'playlists.song.add'|trans({}, 'management') }}</button>
            </form>
        {% endif %}
    </div>
</section>
{% else %}
    <div class="empty">{{ 'playlists.empty'|trans }}</div>
{% endfor %}
</div>
{% endblock %}
