<!doctype html>
<html lang="{{ locale }}">
<body style="margin:0;background:#f4f6f8;font-family:Arial,sans-serif;color:#18222a">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f4f6f8;padding:32px 12px">
<tr><td align="center">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:620px;background:#ffffff;border:1px solid #dfe4e8;border-radius:12px">
<tr><td style="padding:28px">
<div style="font-size:22px;font-weight:700;color:#0a4d4a;margin-bottom:24px">EZSCORE v1</div>
<h1 style="font-size:24px;margin:0 0 18px">{{ 'publication_mail.heading'|trans({'%title%': song.title}, 'publication_mail', locale) }}</h1>
<p>{{ 'publication_mail.hello'|trans({'%name%': recipient.displayName}, 'publication_mail', locale) }}</p>
<p>{{ 'publication_mail.body'|trans({'%artist%': song.artist}, 'publication_mail', locale) }}</p>

{% if song.coverPath %}
<p style="margin:24px 0">
    <img src="{{ absolute_url(song.coverPath) }}" alt="{{ song.title }}" style="max-width:220px;border-radius:12px;display:block">
</p>
{% endif %}

<p style="margin:26px 0">
<a href="{{ song_url }}" style="display:inline-block;background:#0a4d4a;color:#ffffff;text-decoration:none;padding:12px 18px;border-radius:8px;font-weight:700">{{ 'publication_mail.open'|trans({}, 'publication_mail', locale) }}</a>
</p>

<p style="font-size:12px;color:#65727c">
{{ 'publication_mail.preferences'|trans({}, 'publication_mail', locale) }}
<a href="{{ profile_url }}">{{ 'publication_mail.profile'|trans({}, 'publication_mail', locale) }}</a>
</p>
</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
