<!doctype html>
<html lang="{{ locale }}">
<body style="margin:0;background:#f4f6f8;font-family:Arial,sans-serif;color:#18222a">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f4f6f8;padding:32px 12px">
<tr><td align="center">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:620px;background:#ffffff;border:1px solid #dfe4e8;border-radius:12px">
<tr><td style="padding:28px">
<div style="font-size:22px;font-weight:700;color:#0a4d4a;margin-bottom:24px">EZSCORE v1</div>
<h1 style="font-size:24px;margin:0 0 18px">{{ copy.heading }}</h1>
<p>{{ copy.hello }}</p>
<p>{{ copy.body }}</p>
<p style="margin:26px 0">
<a href="{{ activation_url }}" style="display:inline-block;background:#0a4d4a;color:#ffffff;text-decoration:none;padding:12px 18px;border-radius:8px;font-weight:700">{{ copy.button }}</a>
</p>
<p style="font-size:13px;color:#586772">{{ copy.expiry }}</p>
<p style="font-size:13px;color:#586772">{{ copy.ignore }}</p>
</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
