{% extends 'base.html.twig' %}
{% block title %}{{ 'catalog.title'|trans }} — EZScore_v1{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="/assets/css/catalog.css?v=20260925r104">
{% endblock %}

{% block body %}
{% if is_public_catalog %}
<section class="catalog-hero">
    <div class="catalog-hero-copy">
        <div class="eyebrow">{{ 'catalog.public.eyebrow'|trans }}</div>
        <h1>{{ 'catalog.public.heading'|trans }}</h1>
        <p>{{ 'catalog.public.lead'|trans }}</p>

        <div class="catalog-hero-actions">
            <a class="catalog-cta primary-cta" href="{{ path('app_register', {'_locale': app.request.locale}) }}">
                {{ 'catalog.public.register'|trans }}
            </a>
            <a class="catalog-cta secondary-cta" href="{{ path('app_login', {'_locale': app.request.locale}) }}">
                {{ 'auth.login.submit'|trans }}
            </a>
        </div>

        <p class="catalog-free-note">{{ 'catalog.public.free_note'|trans }}</p>
    </div>

    <div class="catalog-benefits" aria-label="{{ 'catalog.public.benefits_heading'|trans }}">
        <article>
            <span class="benefit-icon" aria-hidden="true">♪</span>
            <div>
                <strong>{{ 'catalog.public.benefit.karaoke.title'|trans }}</strong>
                <span>{{ 'catalog.public.benefit.karaoke.body'|trans }}</span>
            </div>
        </article>
        <article>
            <span class="benefit-icon" aria-hidden="true">▶</span>
            <div>
                <strong>{{ 'catalog.public.benefit.audio.title'|trans }}</strong>
                <span>{{ 'catalog.public.benefit.audio.body'|trans }}</span>
            </div>
        </article>
        <article>
            <span class="benefit-icon" aria-hidden="true">≡</span>
            <div>
                <strong>{{ 'catalog.public.benefit.organise.title'|trans }}</strong>
                <span>{{ 'catalog.public.benefit.organise.body'|trans }}</span>
            </div>
        </article>
        <div class="catalog-coming-soon">
            <span>{{ 'catalog.public.future_label'|trans }}</span>
            <strong>{{ 'catalog.public.future_value'|trans }}</strong>
        </div>
    </div>
</section>
{% endif %}

<header class="catalog-heading">
    <div>
        <div class="eyebrow">{{ 'catalog.eyebrow'|trans }}</div>
        <h1>{{ 'catalog.title'|trans }}</h1>
        {% if app.user %}
            <p>{{ 'catalog.member_lead'|trans }}</p>
        {% else %}
            <p>{{ 'catalog.public.catalog_lead'|trans }}</p>
        {% endif %}
    </div>

    {% if can_import %}
        <a class="catalog-import-button" href="{{ path('app_song_import', {'_locale': app.request.locale}) }}">
            <span class="catalog-import-icon" aria-hidden="true">↥</span>
            <span class="catalog-import-copy">
                <span class="catalog-import-kicker">{{ 'catalog.import.kicker'|trans }}</span>
                <strong>{{ 'catalog.import.label'|trans }}</strong>
                <small>{{ 'catalog.import.button_help'|trans }}</small>
            </span>
        </a>
    {% endif %}
</header>

{% if not app.user %}
<form class="public-catalog-search" method="get" action="{{ path('app_catalog', {'_locale': app.request.locale}) }}" role="search">
    <label class="sr-only" for="public-catalog-search">{{ 'layout.search.label'|trans }}</label>
    <input id="public-catalog-search" type="search" name="q" value="{{ query }}" placeholder="{{ 'layout.search.placeholder'|trans }}" autocomplete="off">
    <button type="submit">{{ 'layout.search.submit'|trans }}</button>
</form>
{% endif %}

{% if query %}
<div class="catalog-search-context">
    {{ 'catalog.search.results_for'|trans({'%query%': query}) }}
    <a href="{{ path('app_catalog', {'_locale': app.request.locale}) }}">{{ 'catalog.search.clear'|trans }}</a>
</div>
{% endif %}

<div class="catalog-song-grid">
    {% for song in songs %}
        <a class="catalog-song-card" href="{{ path('app_song_workspace', {'_locale': app.request.locale, id: song.id}) }}">
            <div class="catalog-cover">{% if song.coverPath %}<img src="{{ song.coverPath }}" alt="">{% else %}<span aria-hidden="true">♫</span>{% endif %}</div>
            <div class="catalog-song-copy">
                <div class="catalog-song-title-row">
                    <strong>{{ song.title }}</strong>
                    {% if app.user and (is_granted('ROLE_ADMIN') or is_granted('ROLE_EDITOR')) %}
                        <span class="song-status-badge status-{{ song.status.value }}">{{ ('song.status.' ~ song.status.value)|trans }}</span>
                    {% elseif not app.user %}
                        <span class="preview-badge">{{ 'catalog.public.preview_badge'|trans }}</span>
                    {% endif %}
                </div>
                <span class="catalog-artist">{{ song.artist }}</span>
                {% if song.editor and app.user %}
                    <small>{{ 'song.editor'|trans }} · {{ song.editor.displayName }}</small>
                {% endif %}
                {% if song.comment and app.user %}
                    <small>{{ song.comment }}</small>
                {% endif %}

                {% set rating = ratings[song.id] ?? {'average': 0, 'count': 0} %}
                <div class="catalog-rating-summary" aria-label="{{ 'song.rating.summary_aria'|trans({'%average%': rating.average, '%count%': rating.count}) }}">
                    <span class="rating-stars-static" aria-hidden="true">
                        {% for star in 1..5 %}<span class="{{ rating.average >= star - 0.5 ? 'filled' : '' }}">★</span>{% endfor %}
                    </span>
                    {% if rating.count > 0 %}
                        <strong>{{ rating.average|number_format(1, ',', ' ') }}</strong>
                        <small>{{ 'song.rating.count'|trans({'%count%': rating.count}) }}</small>
                    {% else %}
                        <small>{{ 'song.rating.none'|trans }}</small>
                    {% endif %}
                </div>
            </div>
            <span class="catalog-card-arrow" aria-hidden="true">→</span>
        </a>
    {% else %}
        <div class="catalog-empty">
            <strong>{{ query ? ('catalog.search.none'|trans) : ('catalog.empty'|trans) }}</strong>
            {% if is_public_catalog %}
                <span>{{ 'catalog.public.empty_hint'|trans }}</span>
            {% endif %}
        </div>
    {% endfor %}
</div>
{% endblock %}
