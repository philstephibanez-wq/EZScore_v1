{% extends 'base.html.twig' %}
{% block title %}{{ 'auth.first_run.title'|trans }} — EZScore_v1{% endblock %}
{% block body %}
<section class="auth-card">
    <div class="eyebrow">{{ 'auth.first_run.eyebrow'|trans }}</div>
    <h1>{{ 'auth.first_run.heading'|trans }}</h1>
    <p>{{ 'auth.first_run.description'|trans }}</p>

    <div class="locale-switcher locale-switcher-auth" aria-label="{{ 'locale.label'|trans }}">
        {% for locale in ['fr', 'en'] %}
            <form method="post" action="{{ path('app_locale', {locale: locale}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('locale') }}">
                <button type="submit" class="{{ app.request.locale == locale ? 'active' : '' }}">
                    {{ ('locale.' ~ locale)|trans }}
                </button>
            </form>
        {% endfor %}
    </div>

    {% for error in errors %}
        <div class="flash flash-error">{{ error|trans }}</div>
    {% endfor %}

    <form method="post" class="form-grid">
        <input type="hidden" name="_token" value="{{ csrf_token('first_run') }}">
        <label>{{ 'users.display_name'|trans }}<input name="display_name" required autofocus></label>
        <label>{{ 'users.email'|trans }}<input type="email" name="email" required></label>
        <label>{{ 'users.password'|trans }}<input type="password" name="password" minlength="10" required></label>
        <label>{{ 'users.password_confirm'|trans }}<input type="password" name="confirm_password" minlength="10" required></label>
        <button class="primary" type="submit">{{ 'auth.first_run.create'|trans }}</button>
    </form>
</section>
{% endblock %}
