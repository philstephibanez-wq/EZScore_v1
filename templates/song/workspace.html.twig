{% extends 'base.html.twig' %}
{% block title %}{{ song.title }} — EZScore_v1{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="/assets/css/catalog.css?v=20260925r8">
{% endblock %}

{% block body %}
<div class="workspace" data-can-edit="{{ can_edit ? '1' : '0' }}">
    <nav class="workflow-tabs">
        <button class="workflow-tab active" data-step="1">1 · STEMS</button>
        <button class="workflow-tab" data-step="2">2 · {{ 'workspace.lyrics'|trans }}</button>
    </nav>

    <section class="song-cartouche">
        <div><span>{{ 'song.title'|trans }}</span><strong>{{ song.title }}</strong></div>
        <div><span>{{ 'song.artist'|trans }}</span><strong>{{ song.artist }}</strong></div>
        <div><span>{{ 'song.editor'|trans }}</span><strong>{{ song.editor ? song.editor.displayName : ('common.none'|trans) }}</strong></div>
        <div><span>{{ 'song.time_signature'|trans }}</span><strong>{{ song.timeSignature }}</strong></div>
        <div><span>{{ 'song.capo'|trans }}</span><strong>{{ song.capo }}</strong></div>
        <div><span>{{ 'song.strumming'|trans }}</span><strong>{{ song.strummingPrimary ?: ('common.none'|trans) }}</strong></div>
    </section>

    <section class="song-access-bar">
        <div>
            <span class="publication-badge {{ song.published ? 'published' : 'draft' }}">
                {{ song.published ? ('song.publication.published_badge'|trans) : ('song.publication.draft_badge'|trans) }}
            </span>

            {% if karaoke_preview_seconds > 0 %}
                <span class="access-chip preview">{{ 'workspace.access.preview'|trans({'%seconds%': karaoke_preview_seconds}) }}</span>
            {% elseif can_use_karaoke %}
                <span class="access-chip">{{ 'workspace.access.karaoke_full'|trans }}</span>
            {% endif %}

            {% if can_play_audio %}
                <span class="access-chip">{{ 'workspace.access.audio_full'|trans }}</span>
            {% endif %}
        </div>

        {% if can_publish %}
            <form method="post" action="{{ path('app_song_publication', {'_locale': app.request.locale, id: song.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('song_publication_' ~ song.id) }}">
                {% if song.published %}
                    <button type="submit" name="action" value="unpublish">{{ 'song.publication.unpublish'|trans }}</button>
                {% else %}
                    <button class="primary" type="submit" name="action" value="publish">{{ 'song.publication.publish'|trans }}</button>
                {% endif %}
            </form>
        {% endif %}
    </section>

    {% if not app.user %}
        <section class="panel public-song-gate">
            <div>
                <div class="eyebrow">{{ 'workspace.public_gate.eyebrow'|trans }}</div>
                <h2>{{ 'workspace.public_gate.heading'|trans }}</h2>
                <p>{{ 'workspace.public_gate.body'|trans({'%seconds%': karaoke_preview_seconds}) }}</p>
            </div>
            <div class="catalog-hero-actions">
                <a class="catalog-cta primary-cta" href="{{ path('app_register', {'_locale': app.request.locale}) }}">{{ 'catalog.public.register'|trans }}</a>
                <a class="catalog-cta secondary-cta" href="{{ path('app_login', {'_locale': app.request.locale}) }}">{{ 'auth.login.submit'|trans }}</a>
            </div>
        </section>
    {% endif %}

    <section class="panel song-rating-panel">
        <div class="song-rating-heading">
            <div>
                <div class="eyebrow">{{ 'song.rating.eyebrow'|trans }}</div>
                <h2>{{ 'song.rating.heading'|trans }}</h2>
            </div>

            <div class="song-rating-average">
                <span class="rating-stars-static large" aria-hidden="true">
                    {% for star in 1..5 %}<span class="{{ rating_summary.average >= star - 0.5 ? 'filled' : '' }}">★</span>{% endfor %}
                </span>
                {% if rating_summary.count > 0 %}
                    <strong>{{ rating_summary.average|number_format(1, ',', ' ') }}/5</strong>
                    <small>{{ 'song.rating.count'|trans({'%count%': rating_summary.count}) }}</small>
                {% else %}
                    <strong>—</strong>
                    <small>{{ 'song.rating.none'|trans }}</small>
                {% endif %}
            </div>
        </div>

        {% if app.user %}
            <form class="song-rating-form" method="post" action="{{ path('app_song_rating', {'_locale': app.request.locale, id: song.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('song_rating_' ~ song.id) }}">
                <span class="song-rating-label">{{ 'song.rating.yours'|trans }}</span>

                <div class="rating-choice" role="radiogroup" aria-label="{{ 'song.rating.yours'|trans }}">
                    {% for star in 1..5 %}
                        <label title="{{ 'song.rating.star_title'|trans({'%star%': star}) }}">
                            <input type="radio" name="rating" value="{{ star }}" {{ user_rating == star ? 'checked' : '' }}>
                            <span aria-hidden="true">★</span>
                            <span class="sr-only">{{ 'song.rating.star_title'|trans({'%star%': star}) }}</span>
                        </label>
                    {% endfor %}
                </div>

                <div class="song-rating-actions">
                    <button class="primary" type="submit">{{ 'song.rating.save'|trans }}</button>
                    {% if user_rating %}
                        <button type="submit" name="rating" value="0">{{ 'song.rating.remove'|trans }}</button>
                    {% endif %}
                </div>
            </form>
        {% else %}
            <p class="song-rating-public-note">
                {{ 'song.rating.login_note'|trans }}
                <a href="{{ path('app_login', {'_locale': app.request.locale}) }}">{{ 'auth.login.submit'|trans }}</a>
            </p>
        {% endif %}
    </section>

    <section class="panel source-truth-panel">
        <h2>{{ 'workspace.no_analysis.heading'|trans }}</h2>
        <p>{{ 'workspace.no_analysis.body'|trans }}</p>
    </section>

    {% if can_edit %}
        <section class="panel">
            <h2>{{ 'workspace.edit.heading'|trans }}</h2>
            <p>{{ 'workspace.edit.body'|trans }}</p>
        </section>
    {% endif %}
</div>
{% endblock %}
