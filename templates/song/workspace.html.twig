{% extends 'base.html.twig' %}
{% block title %}{{ song.title }} — EZScore_v1{% endblock %}
{% block body %}
<div class="workspace" data-can-edit="{{ can_edit ? '1' : '0' }}">
    <nav class="workflow-tabs">
        <button class="workflow-tab active" data-step="1">1 · STEMS</button>
        <button class="workflow-tab" data-step="2">2 · {{ 'workspace.lyrics'|trans }}</button>
    </nav>

    <section class="song-cartouche">
        <div><span>{{ 'song.title'|trans }}</span><strong>{{ song.title }}</strong></div>
        <div><span>{{ 'song.artist'|trans }}</span><strong>{{ song.artist }}</strong></div>
        <div><span>{{ 'song.editor'|trans }}</span><strong>{{ song.editor ? song.editor.displayName : ('common.none'|trans) }}</strong></div>
        <div><span>{{ 'song.time_signature'|trans }}</span><strong>{{ song.timeSignature }}</strong></div>
        <div><span>{{ 'song.capo'|trans }}</span><strong>{{ song.capo }}</strong></div>
        <div><span>{{ 'song.strumming'|trans }}</span><strong>{{ song.strummingPrimary ?: ('common.none'|trans) }}</strong></div>
    </section>

    <section class="panel source-truth-panel">
        <h2>{{ 'workspace.no_analysis.heading'|trans }}</h2>
        <p>{{ 'workspace.no_analysis.body'|trans }}</p>
    </section>

    {% if can_edit %}
        <section class="panel">
            <h2>{{ 'workspace.edit.heading'|trans }}</h2>
            <p>{{ 'workspace.edit.body'|trans }}</p>
        </section>
    {% endif %}
</div>
{% endblock %}
