<div class="ez-workspace">
  <nav class="workflow-tabs">
    <button class="tab active" type="button">1 · STEMS</button>
    <button class="tab" type="button">2 · PAROLES</button>
  </nav>

  <section class="song-card">
    <div><span>Titre</span><strong>{{ song.title }}</strong></div>
    <div><span>Auteur / Interprète</span><strong>{{ song.artist }}</strong></div>
    <div><span>Éditeur</span><strong>{{ song.editor }}</strong></div>
    <div><span>Time sig</span><strong>{{ song.time_signature }}</strong></div>
    <div><span>Capo</span><strong>{{ song.capo }}</strong></div>
    <div><span>Strumming</span><strong>{{ song.strumming }}</strong></div>
  </section>

  <details open class="panel">
    <summary>🎚️ STEMS + table de mixage</summary>
    <div class="mixer">
      <div class="mix-head"><span>Piste</span><span>ON</span><span>Volume</span><span>Graves</span><span>Médiums</span><span>Aigus</span></div>
      {% for stem in stems %}
      <div class="mix-row">
        <strong>{{ stem }}</strong>
        <input type="checkbox" {% if loop.first %}checked{% endif %}>
        <input type="range" min="0" max="100" value="{% if loop.first %}100{% else %}72{% endif %}">
        <input type="range" min="-12" max="12" value="0">
        <input type="range" min="-12" max="12" value="0">
        <input type="range" min="-12" max="12" value="0">
      </div>
      {% endfor %}
    </div>
  </details>

  <details open class="panel">
    <summary>▶ Player mock</summary>
    <div class="player">
      <div class="waveform"></div>
      <div class="playhead"></div>
      <div class="diagram">G<br><small>diagramme</small></div>
      <div class="measure-strip">
        {% for measure in measures %}
        <div class="measure">
          <div class="measure-no">#{{ measure.number }}</div>
          <div class="beats">
            {% for beat in measure.beats %}
            <span class="beat {% if measure.number == 3 and loop.index == 1 %}current{% endif %}">{{ beat }}</span>
            {% endfor %}
          </div>
        </div>
        {% endfor %}
      </div>
      <div class="lyrics-line">
        {% for word in words %}<span class="word {% if loop.index == 7 %}current{% endif %}">{{ word }}</span>{% endfor %}
      </div>
      <input class="seek" type="range" min="0" max="100" value="38">
      <div class="transport"><button>▶</button><button>⏸</button><button>⏹</button><select><option>1,00×</option><option>0,75×</option><option>1,25×</option></select><span>1:08 / 4:22</span></div>
    </div>
  </details>

  <details class="panel editor-panel" {% if permissions.readonly %}hidden{% endif %}>
    <summary>✏️ Édition paroles / accords / blocs</summary>
    <div class="editor-mock">
      <div>Sections</div><div>Accords</div><div>Chant</div><div>Chœurs</div>
    </div>
  </details>
</div>
