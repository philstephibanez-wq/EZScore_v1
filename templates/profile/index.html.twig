{% extends 'base.html.twig' %}
{% block title %}{{ 'profile.title'|trans }} — EZSCORE v1{% endblock %}
{% block body %}
<header class="page-head">
    <div><div class="eyebrow">EZSCORE v1</div><h1>{{ 'profile.title'|trans }}</h1></div>
</header>

<section class="panel" style="max-width:720px">
    <h2>{{ 'profile.account.heading'|trans }}</h2>
    <p><strong>{{ app.user.displayName }}</strong><br>{{ app.user.email }}</p>
    <form method="post" class="row-form">
        <input type="hidden" name="_token" value="{{ csrf_token('profile_locale') }}">
        <label>
            <span>{{ 'locale.label'|trans }}</span>
            <select name="locale">
                {% for locale in supported_locales %}
                    <option value="{{ locale }}" {{ app.user.locale == locale ? 'selected' : '' }}>{{ ('locale.' ~ locale)|trans }}</option>
                {% endfor %}
            </select>
        </label>
        <button class="primary" type="submit">{{ 'common.save'|trans }}</button>
    </form>
</section>

<section class="panel" style="max-width:720px">
    <div class="eyebrow">{{ 'profile.subscription.eyebrow'|trans }}</div>
    <h2>{{ 'profile.subscription.heading'|trans }}</h2>
    <p class="page-note">{{ 'profile.subscription.body'|trans }}</p>

    <div class="subscription-summary">
        <div>
            <span>{{ 'profile.subscription.current_label'|trans }}</span>
            <strong>{{ 'profile.subscription.current_value'|trans }}</strong>
        </div>
        <div>
            <span>{{ 'profile.subscription.karaoke_label'|trans }}</span>
            <strong>{{ 'profile.subscription.karaoke_value'|trans }}</strong>
        </div>
        <div>
            <span>{{ 'profile.subscription.future_label'|trans }}</span>
            <strong>{{ 'profile.subscription.future_value'|trans }}</strong>
        </div>
    </div>
</section>
{% endblock %}
