APP_ENV=dev
APP_DEBUG=1
APP_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
DATABASE_URL="sqlite:///%kernel.project_dir%/data/ezscore_v1.sqlite"

EZ_ANALYSIS_URL="http://127.0.0.1:8502"

GOOGLE_CLIENT_ID=""
