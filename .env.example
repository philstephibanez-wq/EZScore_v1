# Transactional email. Configure a real SMTP/provider DSN.
# No null://null fallback: activation delivery failures must remain explicit.
MAILER_DSN="smtp://USER:PASSWORD@smtp.example.com:587"
MAILER_FROM="no-reply@example.com"
